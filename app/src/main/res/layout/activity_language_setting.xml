<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ScreenBackground"
    android:orientation="vertical"
    tools:context=".ui.setting.LanguageSettingActivity">

    <!-- Fixed Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        style="@style/ScreenBackground">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/back_arrow"
            android:contentDescription="Back button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setting"
            android:textSize="20sp"
            android:textStyle="bold"
            style="@style/Theme.NaSiGoYeng"
            android:textColor="?attr/colorPrimary"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:text="Save"
            android:textColor="@color/dusty_coral"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/rounded_button_pink"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Language Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="16dp">

        <!-- English Option -->
        <LinearLayout
            android:id="@+id/layout_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/settings_item_background"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radio_english"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="true"
                android:buttonTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="English"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/soft_black" />

        </LinearLayout>

        <!-- Indonesia Option -->
        <LinearLayout
            android:id="@+id/layout_indonesia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/settings_item_background"
            android:layout_marginBottom="8dp">

            <RadioButton
                android:id="@+id/radio_indonesia"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:checked="false"
                android:buttonTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Indonesia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/soft_black" />

        </LinearLayout>

    </LinearLayout>



</LinearLayout>