<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ScreenBackground"
    android:orientation="vertical"
    tools:context=".ui.addrecipe.AddRecipeActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/colorSurface">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/back_arrow"
            android:contentDescription="Back button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create Recipe"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnPublish"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:text="Publish"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@drawable/rounded_button_pink"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/officialBadge"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center"
                android:padding="8dp"
                >

                <ImageView
                    android:id="@+id/ivOfficialIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/round_check_24"
                    android:background="@drawable/rounded_image_background"
                    app:tint="?attr/colorSurface"
                    android:contentDescription="Verified icon"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvOfficialText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Recipe"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Recipe Name Section -->
            <LinearLayout
                android:id="@+id/recipeNameSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvRecipeNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recipe Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="8dp"
                    />

                <EditText
                    android:id="@+id/etRecipeName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:hint="Enter recipe name"
                    android:textColor="@color/soft_black"
                    android:textColorHint="?attr/colorSecondary"
                    android:background="@drawable/edittext_background"
                     />

            </LinearLayout>

            <!-- Image Upload Section -->
            <LinearLayout
                android:id="@+id/imageSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvImageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recipe Image"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:id="@+id/imageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:background="@drawable/dashed_border"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivRecipeImage"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_image_placeholder"
                        android:contentDescription="Recipe image"
                        android:scaleType="centerCrop" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvAddImageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to add image"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOutline" />

            </LinearLayout>

            <!-- Recipe Description Section -->
            <LinearLayout
                android:id="@+id/descriptionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvDescriptionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recipe Description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etRecipeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Describe your recipe..."
                    android:textSize="14sp"
                    android:textColorHint="?attr/colorSecondary"
                    android:textColor="?attr/colorOnBackground"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLines="4" />

                <TextView
                    android:id="@+id/tvTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cooking Time (minutes)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etCookingTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 30"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnBackground"
                    android:inputType="number"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp" />

                <TextView
                    android:id="@+id/tvCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calories"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etCalories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 500"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnBackground"
                    android:inputType="number"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp" />


            </LinearLayout>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text=""
                android:visibility="invisible" />

            <!-- Ingredients Section -->
            <LinearLayout
                android:id="@+id/ingredientsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvIngredientsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingredients"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_ingredient" />

                <Button
                    android:id="@+id/btnAddIngredient"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="+ Add Ingredient"
                    android:enabled="true"
                    android:textSize="14sp"
                    android:textColor="?attr/colorSurface"
                    android:background="@drawable/rounded_button_pink"
                    android:layout_marginTop="16dp" />

            </LinearLayout>


            <!-- Instructions Section -->
            <LinearLayout
                android:id="@+id/instructionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvInstructionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instructions"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_instruction" />

                <Button
                    android:id="@+id/btnAddInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="+ Add Instruction"
                    android:enabled="true"
                    android:textSize="14sp"
                    android:textColor="?attr/colorSurface"
                    android:background="@drawable/rounded_button_pink"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Category Section -->
            <LinearLayout
                android:id="@+id/categorySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/tvCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorSecondary"
                    android:layout_marginBottom="16dp" />

                <!-- Spinner Dropdown -->
                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingHorizontal="16dp"
                     />


            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>