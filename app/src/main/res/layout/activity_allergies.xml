<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ScreenBackground">

    <ImageView
        android:id="@+id/backIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/back_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="120dp"
        android:layout_height="12dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:progress="100"
        android:progressTint="#FF5A7E"
        android:backgroundTint="#E0E0E0"
        android:indeterminate="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/backIcon"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@+id/buttonContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allergy_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/allergy_subtitle"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <GridLayout
                android:id="@+id/gridAllergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="24dp">

                <!-- Banana Item -->
                <LinearLayout
                    android:id="@+id/itemBanana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/banana"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_banana"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Meat Item -->
                <LinearLayout
                    android:id="@+id/itemMeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/meat"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meat"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Kiwi Item -->
                <LinearLayout
                    android:id="@+id/itemKiwi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kiwi"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_kiwi"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Almonds Item -->
                <LinearLayout
                    android:id="@+id/itemAlmonds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/almonds"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_almonds"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Milk Item -->
                <LinearLayout
                    android:id="@+id/itemMilk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/milk"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_milk"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Eggs Item -->
                <LinearLayout
                    android:id="@+id/itemEggs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/eggs"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eggs"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Continue with other items... -->
                <!-- Peanuts Item -->
                <LinearLayout
                    android:id="@+id/itemPeanuts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/peanuts"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_peanuts"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Wheat Item -->
                <LinearLayout
                    android:id="@+id/itemWheat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/wheat"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_wheat"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Shrimp Item -->
                <LinearLayout
                    android:id="@+id/itemShrimp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/shrimp"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_shrimp"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Tree Nuts Item -->
                <LinearLayout
                    android:id="@+id/itemTreeNuts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/tree_nuts"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_tree_nuts"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Shellfish Item -->
                <LinearLayout
                    android:id="@+id/itemShellfish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/shellfish"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_shellfish"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Fish Item -->
                <LinearLayout
                    android:id="@+id/itemFish"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/fish"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_fish"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Soy Item -->
                <LinearLayout
                    android:id="@+id/itemSoy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/soy"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soy"
                        android:textSize="14sp"
                        android:textColor="#000000"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Sesame Item -->
                <LinearLayout
                    android:id="@+id/itemSesame"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sesame"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_sesame"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Mustard Item -->
                <LinearLayout
                    android:id="@+id/itemMustard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_margin="8dp"
                    android:gravity="center"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/selected_item"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mustard"
                        android:background="@drawable/rounded_image_background" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/allergy_mustard"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/buttonContinue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="?attr/colorPrimary"
        android:text="@string/onboarding_continue"
        android:textColor="?attr/colorSurface"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>